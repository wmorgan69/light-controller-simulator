{
  "name": "devices-frontends",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/Devices.BuildingControl.Web/frontend src/Devices.Instrumentation.Web/frontend --max-warnings 0",
    "test:lint": "node --test tests/lint-config.test.mjs",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "build": "npm run typecheck && npm run build:simulator && npm run build:instrumentation",
    "build:simulator": "vite build --mode simulator",
    "build:instrumentation": "vite build --mode instrumentation"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.6.0",
    "@mui/material": "9.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.1"
    }
  }
}
