%% Control schema version 1.
%%{init: {'theme':'base','themeVariables':{'primaryColor':'#1E293B','primaryTextColor':'#F8FAFC','primaryBorderColor':'#60A5FA','lineColor':'#60A5FA','secondaryColor':'#1E293B','tertiaryColor':'#1E293B','textColor':'#F8FAFC','attributeBackgroundColorOdd':'#1E293B','attributeBackgroundColorEven':'#27364D'},'themeCSS':'.row-rect-odd path[stroke=none] { fill: #1E293B !important; } .row-rect-even path[stroke=none] { fill: #27364D !important; }'}}%%
erDiagram
    BUILDING ||--o{ BUILDING_DESIGN : owns
    BUILDING o|--|| BUILDING_DESIGN : "saved design"
    BUILDING o|--|| BUILDING_DESIGN : "active design"
    BUILDING ||--o{ RETIRED_DESIGN_ENTITY_ID : records
    BUILDING ||--o{ CONTROLLER_MQTT_RETAINED_CLEANUP : queues

    SCHEMA_VERSION {
        uuid id PK "UUIDv7"
        smallint singleton_key UK "Always 1"
        integer version
        boolean seeded
        timestamptz applied_at
        timestamptz created_at
        timestamptz updated_at
    }

    BUILDING {
        uuid id PK "UUIDv7"
        smallint singleton_key UK "Always 1"
        text name
        uuid saved_design_id FK "Owned by this building"
        uuid active_design_id FK "Owned by this building"
        bigint edit_revision
        timestamptz created_at
        timestamptz updated_at
    }

    BUILDING_DESIGN {
        uuid id PK "UUIDv7"
        uuid building_id FK
        jsonb design
        bigint revision
        timestamptz created_at
        timestamptz updated_at
    }

    RETIRED_DESIGN_ENTITY_ID {
        uuid id PK "UUIDv7"
        uuid building_id FK
        text external_id UK "Globally unique stable entity ID"
        text entity_type
        timestamptz retired_at
        timestamptz created_at
        timestamptz updated_at
    }

    CONTROLLER_MQTT_RETAINED_CLEANUP {
        uuid id PK "UUIDv7"
        uuid building_id FK
        text controller_id UK "Globally unique stable controller ID"
        bigint active_design_revision
        smallint status
        timestamptz created_at
        timestamptz updated_at
    }
